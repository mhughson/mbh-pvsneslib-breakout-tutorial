*.sym
*.symfull
*.log
hdr.asm
linkfile
*.obj
*.ps
*.dbg
**/src/game.asm
**/src/main.asm

# Converted graphics and audio (regenerated from source assets)
*.pic
*.pal
*.map
*.inc
*_data.as
**/res/

# Native test binaries and Python caches
/build/
node_modules/
/site/content/
/site/public/
/site/.vitepress/cache/
/site/.vitepress/rom-versions.json
__pycache__/
*.py[cod]

# Project-local PVSnesLib SDK
/vendor/pvsneslib/*
!/vendor/pvsneslib/README.md

# Local editor and operating-system files
/.vscode/
.DS_Store
Thumbs.db
